# Copy this file to .env and fill in what you have. Everything is optional:
# the default projects run entirely on free, key-less sources.

# Contact e-mail sent in the User-Agent header of every request (polite scraping).
DATAHARVEST_CONTACT_EMAIL=

# Google Maps Platform - Places API (New). Enables the `google_places` source.
GOOGLE_MAPS_API_KEY=

# Google Programmable Search (Custom Search JSON API). Enables the `google_cse` search provider.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Apollo.io - enables the `apollo` source and Apollo enrichment.
APOLLO_API_KEY=

# Google Sheets export - path to a service-account JSON key file (or the JSON itself).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: existing spreadsheet ID to update instead of creating a new one.
GOOGLE_SHEETS_ID=
